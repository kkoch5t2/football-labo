# Django Settings
SECRET_KEY=your_secret_key_here
DEBUG=True
DJANGO_ADMIN_URL=admin/

# Database Settings
SQL_DATABASE=football_labo_db
SQL_USER=postgres
SQL_PASSWORD=postgres
SQL_HOST=db
SQL_PORT=5432

# Local Database Initialization
POSTGRES_DB=football_labo_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Network / Domain Settings
PROTOCOL=http
DOMAIN=localhost

# Email Settings
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=your_email@gmail.com
EMAIL_HOST_PASSWORD=your_app_password
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=your_email@example.com
CONTACT_EMAIL=your_contact_email@example.com

# Twitter API (Tweepy)
TWEEPY_BEARER_TOKEN=your_bearer_token
TWEEPY_CONSUMER_KEY=your_consumer_key
TWEEPY_CONSUMER_SECRET=your_consumer_secret
TWEEPY_ACCESS_TOKEN=your_access_token
TWEEPY_ACCESS_TOKEN_SECRET=your_access_token_secret

# Recaptcha
RECAPTCHA_PUBLIC_KEY=your_recaptcha_public_key
RECAPTCHA_PRIVATE_KEY=your_recaptcha_private_key

# Google Tags
GOOGLE_ADSENSE_PUBLISHER_ID=ca-pub-xxxxxxxxxxxxxxxx
GOOGLE_ANALYTICS_TRACKING_ID=UA-xxxxxxxx-x
